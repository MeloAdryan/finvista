        private String normalizarTexto(
                String valor) {
            
        if (valor == null) {
                        return null;
        }

        String normalizado = valor.trim();
            
        if (normalizado.isEmpty()) {
                        return null;
        }
    
                return normalizado;
    }
            
        private BigDecimal normalizarValor(
                BigDecimal valor) {
            
        if (valor == null) {
                        return null;
        }
    
                return valor.stripTrailingZeros();
    }

